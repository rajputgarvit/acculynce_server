model warehouses {
  id                   Int                    @id @default(autoincrement())
  company_id           Int?
  name                 String                 @db.VarChar(100)
  code                 String                 @unique(map: "code") @db.VarChar(20)
  address              String?                @db.Text
  city                 String?                @db.VarChar(50)
  state                String?                @db.VarChar(50)
  country              String?                @db.VarChar(50)
  postal_code          String?                @db.VarChar(10)
  manager_id           Int?
  is_active            Boolean?               @default(true)
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  goods_received_notes goods_received_notes[]
  stock_balance        stock_balance[]
  stock_transactions   stock_transactions[]
  employees            employees?             @relation(fields: [manager_id], references: [id], onUpdate: Restrict, map: "warehouses_ibfk_1")
  work_orders          work_orders[]

  @@index([company_id], map: "idx_warehouses_company")
  @@index([manager_id], map: "manager_id")
}

model work_orders {
  id                  Int                  @id @default(autoincrement())
  wo_number           String               @unique(map: "wo_number") @db.VarChar(50)
  product_id          Int
  bom_id              Int?
  quantity_to_produce Decimal              @db.Decimal(10, 2)
  quantity_produced   Decimal?             @default(0.00) @db.Decimal(10, 2)
  warehouse_id        Int
  planned_start_date  DateTime?            @db.Date
  planned_end_date    DateTime?            @db.Date
  actual_start_date   DateTime?            @db.Date
  actual_end_date     DateTime?            @db.Date
  status              work_orders_status?  @default(Draft)
  notes               String?              @db.Text
  created_by          Int?
  created_at          DateTime             @default(now()) @db.Timestamp(0)
  production_entries  production_entries[]
  products            products             @relation(fields: [product_id], references: [id], onUpdate: Restrict, map: "work_orders_ibfk_1")
  bill_of_materials   bill_of_materials?   @relation(fields: [bom_id], references: [id], onUpdate: Restrict, map: "work_orders_ibfk_2")
  warehouses          warehouses           @relation(fields: [warehouse_id], references: [id], onUpdate: Restrict, map: "work_orders_ibfk_3")
  users               users?               @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "work_orders_ibfk_4")

  @@index([bom_id], map: "bom_id")
  @@index([created_by], map: "created_by")
  @@index([product_id], map: "idx_product")
  @@index([status], map: "idx_status")
  @@index([warehouse_id], map: "warehouse_id")
}

