  @@index([department_id], map: "idx_dept")
  @@index([company_id], map: "idx_employees_company")
  @@index([status], map: "idx_status")
  @@index([reporting_to], map: "reporting_to")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model feature_definitions {
  id            Int                           @id @default(autoincrement())
  feature_code  String                        @unique(map: "feature_code") @db.VarChar(50)
  feature_name  String                        @db.VarChar(100)
  description   String?                       @db.Text
  category      feature_definitions_category? @default(feature)
  is_measurable Boolean?                      @default(false)
  default_limit Int?
  is_active     Boolean?                      @default(true)
  display_order Int?                          @default(0)
  created_at    DateTime                      @default(now()) @db.Timestamp(0)

  @@index([category], map: "idx_category")
  @@index([feature_code], map: "idx_code")
}

model fiscal_years {
  id              Int               @id @default(autoincrement())
  year_name       String            @db.VarChar(20)
  start_date      DateTime          @db.Date
  end_date        DateTime          @db.Date
  is_closed       Boolean?          @default(false)
  created_at      DateTime          @default(now()) @db.Timestamp(0)
  journal_entries journal_entries[]
}

model goods_received_notes {
  id              Int                          @id @default(autoincrement())
  grn_number      String                       @unique(map: "grn_number") @db.VarChar(50)
  po_id           Int
  warehouse_id    Int
  received_date   DateTime                     @db.Date
  received_by     Int?
  status          goods_received_notes_status? @default(Draft)
  notes           String?                      @db.Text
  created_at      DateTime                     @default(now()) @db.Timestamp(0)
  purchase_orders purchase_orders              @relation(fields: [po_id], references: [id], onUpdate: Restrict, map: "goods_received_notes_ibfk_1")
  warehouses      warehouses                   @relation(fields: [warehouse_id], references: [id], onUpdate: Restrict, map: "goods_received_notes_ibfk_2")
  employees       employees?                   @relation(fields: [received_by], references: [id], onUpdate: Restrict, map: "goods_received_notes_ibfk_3")
  grn_items       grn_items[]

