  title             String                  @db.VarChar(255)
  message           String                  @db.Text
  type              system_broadcasts_type? @default(info)
  start_date        DateTime                @db.DateTime(0)
  end_date          DateTime                @db.DateTime(0)
  is_active         Boolean?                @default(true)
  target_company_id Int?
  created_by        Int?
  created_at        DateTime                @default(now()) @db.Timestamp(0)
  updated_at        DateTime                @default(now()) @db.Timestamp(0)
}

model system_settings {
  id            Int      @id @default(autoincrement())
  setting_key   String   @unique(map: "setting_key") @db.VarChar(50)
  setting_value String?  @db.Text
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model tax_rates {
  id          Int      @id @default(autoincrement())
  company_id  Int?
  tax_name    String   @db.VarChar(50)
  tax_rate    Decimal  @db.Decimal(5, 2)
  description String?  @db.VarChar(255)
  is_active   Boolean? @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(0)

  @@index([company_id], map: "idx_tax_rates_company")
}

model units_of_measure {
  id         Int                    @id @default(autoincrement())
  company_id Int?
  name       String                 @db.VarChar(50)
  symbol     String                 @db.VarChar(10)
  type       units_of_measure_type? @default(Quantity)
  products   products[]

  @@index([company_id], map: "idx_units_of_measure_company")
}

model usage_alerts {
  id              BigInt                   @id @default(autoincrement())
  company_id      Int
  subscription_id Int
  feature_code    String                   @db.VarChar(50)
  alert_type      usage_alerts_alert_type? @default(warning)
  current_usage   Int
  limit_value     Int
  alert_message   String?                  @db.Text
  is_notified     Boolean?                 @default(false)
  notified_at     DateTime?                @db.DateTime(0)
  created_at      DateTime                 @default(now()) @db.Timestamp(0)
  subscriptions   subscriptions            @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_usage_alerts_subscription")

  @@index([alert_type], map: "idx_alert_type")
  @@index([company_id], map: "idx_company")
  @@index([is_notified], map: "idx_notified")
  @@index([subscription_id], map: "idx_subscription")
}

model user_module_access {
  id         Int      @id @default(autoincrement())
  user_id    Int
  module     String   @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_module_access_ibfk_1")

  @@unique([user_id, module], map: "unique_user_module")
}

model user_roles {
  user_id     Int
  role_id     Int
  assigned_at DateTime @default(now()) @db.Timestamp(0)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_roles_ibfk_1")
  roles       roles    @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_roles_ibfk_2")

  @@id([user_id, role_id])
  @@index([role_id], map: "role_id")
}

model users {
  id                                                              Int                      @id @default(autoincrement())
  company_id                                                      Int?
  username                                                        String                   @unique(map: "username") @db.VarChar(50)
  email                                                           String                   @unique(map: "email") @db.VarChar(100)
  avatar_path                                                     String?                  @db.VarChar(255)
  company_name                                                    String                   @db.VarChar(255)
  password_hash                                                   String                   @db.VarChar(255)
  full_name                                                       String                   @db.VarChar(100)
  mobile                                                          String?                  @db.VarChar(20)
  is_active                                                       Boolean?                 @default(true)
  email_verification_token                                        String?                  @db.VarChar(255)
  password_reset_token                                            String?                  @db.VarChar(255)
  password_reset_expires_at                                       DateTime?                @db.DateTime(0)
  email_verified                                                  Boolean?                 @default(false)
  last_login                                                      DateTime?                @db.Timestamp(0)
  created_at                                                      DateTime                 @default(now()) @db.Timestamp(0)
  updated_at                                                      DateTime                 @default(now()) @db.Timestamp(0)
  onboarding_completed                                            Boolean?                 @default(false)
  activities_activities_assigned_toTousers                        activities[]             @relation("activities_assigned_toTousers")
  activities_activities_created_byTousers                         activities[]             @relation("activities_created_byTousers")
  audit_logs                                                      audit_logs[]
  contact_replies                                                 contact_replies[]
  customer_notes                                                  customer_notes[]
  employees                                                       employees?
  invoices                                                        invoices[]
  journal_entries                                                 journal_entries[]
  leads                                                           leads[]
  opportunities                                                   opportunities[]
  payments                                                        payments[]
  payments_made                                                   payments_made[]
  payments_received                                               payments_received[]
  production_entries                                              production_entries[]
  purchase_invoices                                               purchase_invoices[]
  purchase_orders                                                 purchase_orders[]
  quotations                                                      quotations[]
  sales_orders                                                    sales_orders[]
  sales_targets                                                   sales_targets[]
  stock_transactions                                              stock_transactions[]
  subscription_requests_subscription_requests_processed_byTousers subscription_requests[]  @relation("subscription_requests_processed_byTousers")
  subscription_requests_subscription_requests_user_idTousers      subscription_requests[]  @relation("subscription_requests_user_idTousers")
  subscriptions                                                   subscriptions[]
  support_ticket_replies                                          support_ticket_replies[]
  support_tickets_support_tickets_user_idTousers                  support_tickets[]        @relation("support_tickets_user_idTousers")
  support_tickets_support_tickets_assigned_toTousers              support_tickets[]        @relation("support_tickets_assigned_toTousers")
  user_module_access                                              user_module_access[]
  user_roles                                                      user_roles[]
  work_orders                                                     work_orders[]

  @@index([email], map: "idx_email")
  @@index([email_verification_token], map: "idx_email_verification")
  @@index([username], map: "idx_username")
  @@index([company_id], map: "idx_users_company")
}

