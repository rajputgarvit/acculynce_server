generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model account_types {
  id                Int                    @id @default(autoincrement())
  name              String                 @db.VarChar(50)
  category          account_types_category
  chart_of_accounts chart_of_accounts[]
}

model activities {
  id                                  Int                      @id @default(autoincrement())
  activity_type                       activities_activity_type
  subject                             String                   @db.VarChar(200)
  description                         String?                  @db.Text
  related_to_type                     String?                  @db.VarChar(50)
  related_to_id                       Int?
  scheduled_at                        DateTime                 @default(now()) @db.Timestamp(0)
  completed_at                        DateTime?                @db.Timestamp(0)
  status                              activities_status?       @default(Scheduled)
  assigned_to                         Int?
  created_by                          Int?
  created_at                          DateTime                 @default(now()) @db.Timestamp(0)
  users_activities_assigned_toTousers users?                   @relation("activities_assigned_toTousers", fields: [assigned_to], references: [id], onUpdate: Restrict, map: "activities_ibfk_1")
  users_activities_created_byTousers  users?                   @relation("activities_created_byTousers", fields: [created_by], references: [id], onUpdate: Restrict, map: "activities_ibfk_2")

  @@index([assigned_to], map: "assigned_to")
  @@index([created_by], map: "created_by")
  @@index([related_to_type, related_to_id], map: "idx_related")
  @@index([scheduled_at], map: "idx_scheduled")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model api_credentials {
  id                 Int                     @id @default(autoincrement())
  company_id         Int
  user_id            Int
  name               String                  @db.VarChar(100)
  client_id          String                  @unique(map: "client_id") @db.VarChar(64)
  client_secret_hash String                  @db.VarChar(255)
  status             api_credentials_status? @default(active)
  created_at         DateTime                @default(now()) @db.Timestamp(0)

  @@index([company_id], map: "company_id")
}

model attendance {
  id              BigInt             @id @default(autoincrement())
  employee_id     Int
  attendance_date DateTime           @db.Date
  check_in        DateTime?          @db.Time(0)
  check_out       DateTime?          @db.Time(0)
  status          attendance_status? @default(Present)
  working_hours   Decimal?           @db.Decimal(4, 2)
  overtime_hours  Decimal?           @default(0.00) @db.Decimal(4, 2)
  remarks         String?            @db.Text
  created_at      DateTime           @default(now()) @db.Timestamp(0)
  employees       employees          @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "attendance_ibfk_1")

  @@unique([employee_id, attendance_date], map: "unique_attendance")
  @@index([attendance_date], map: "idx_date")
  @@index([employee_id, attendance_date], map: "idx_employee_date")
}

model audit_logs {
  id         BigInt   @id @default(autoincrement())
  company_id Int?
  user_id    Int?
  action     String   @db.VarChar(100)
  table_name String?  @db.VarChar(50)
  record_id  Int?
  old_values String?  @db.LongText
  new_values String?  @db.LongText
  ip_address String?  @db.VarChar(45)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users?   @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "audit_logs_ibfk_1")

  @@index([created_at], map: "idx_created")
  @@index([table_name, record_id], map: "idx_table")
  @@index([user_id], map: "idx_user")
}

model bank_accounts {
  id                Int                         @id @default(autoincrement())
  company_id        Int?
  account_name      String                      @db.VarChar(100)
  bank_name         String                      @db.VarChar(100)
  account_number    String                      @db.VarChar(50)
  ifsc_code         String?                     @db.VarChar(20)
  branch            String?                     @db.VarChar(100)
  account_type      bank_accounts_account_type? @default(Current)
  opening_balance   Decimal?                    @default(0.00) @db.Decimal(15, 2)
  current_balance   Decimal?                    @default(0.00) @db.Decimal(15, 2)
  chart_account_id  Int?
  is_active         Boolean?                    @default(true)
  chart_of_accounts chart_of_accounts?          @relation(fields: [chart_account_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bank_accounts_ibfk_1")

  @@index([chart_account_id], map: "chart_account_id")
  @@index([company_id], map: "idx_bank_accounts_company")
}

model bill_of_materials {
  id          Int           @id @default(autoincrement())
  bom_number  String        @unique(map: "bom_number") @db.VarChar(50)
  product_id  Int
  quantity    Decimal?      @default(1.00) @db.Decimal(10, 2)
  description String?       @db.Text
  is_active   Boolean?      @default(true)
  created_at  DateTime      @default(now()) @db.Timestamp(0)
  products    products      @relation(fields: [product_id], references: [id], onUpdate: Restrict, map: "bill_of_materials_ibfk_1")
  bom_items   bom_items[]
  work_orders work_orders[]

  @@index([product_id], map: "idx_product")
}

model bom_items {
  id                Int               @id @default(autoincrement())
  bom_id            Int
  component_id      Int
  quantity          Decimal           @db.Decimal(10, 2)
  scrap_percentage  Decimal?          @default(0.00) @db.Decimal(5, 2)
  notes             String?           @db.Text
  bill_of_materials bill_of_materials @relation(fields: [bom_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bom_items_ibfk_1")
  products          products          @relation(fields: [component_id], references: [id], onUpdate: Restrict, map: "bom_items_ibfk_2")

  @@index([bom_id], map: "bom_id")
  @@index([component_id], map: "component_id")
}

model chart_of_accounts {
  id                      Int                   @id @default(autoincrement())
  company_id              Int?
  account_code            String                @unique(map: "account_code") @db.VarChar(20)
  account_name            String                @db.VarChar(200)
  account_type_id         Int
  parent_account_id       Int?
  description             String?               @db.Text
  is_active               Boolean?              @default(true)
  created_at              DateTime              @default(now()) @db.Timestamp(0)
  bank_accounts           bank_accounts[]
  account_types           account_types         @relation(fields: [account_type_id], references: [id], onUpdate: Restrict, map: "chart_of_accounts_ibfk_1")
  chart_of_accounts       chart_of_accounts?    @relation("chart_of_accountsTochart_of_accounts", fields: [parent_account_id], references: [id], onUpdate: Restrict, map: "chart_of_accounts_ibfk_2")
  other_chart_of_accounts chart_of_accounts[]   @relation("chart_of_accountsTochart_of_accounts")
  journal_entry_lines     journal_entry_lines[]

  @@index([company_id], map: "idx_chart_of_accounts_company")
  @@index([account_code], map: "idx_code")
  @@index([account_type_id], map: "idx_type")
  @@index([parent_account_id], map: "parent_account_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model company_feature_overrides {
  id               Int              @id @default(autoincrement())
  company_id       Int
  feature_code     String           @db.VarChar(50)
  is_enabled       Boolean?         @default(true)
  limit_value      Int?
  notes            String?          @db.Text
  created_by       Int?
  created_at       DateTime         @default(now()) @db.Timestamp(0)
  expires_at       DateTime?        @db.DateTime(0)
  company_settings company_settings @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_company_override_company")

  @@unique([company_id, feature_code], map: "unique_company_feature")
  @@index([company_id], map: "idx_company_id")
  @@index([feature_code], map: "idx_feature_code")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
