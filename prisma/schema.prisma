model contact_replies {
  id               Int              @id @default(autoincrement())
  request_id       Int
  user_id          Int
  message          String           @db.Text
  created_at       DateTime         @default(now()) @db.Timestamp(0)
  contact_requests contact_requests @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "contact_replies_ibfk_1")
  users            users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "contact_replies_ibfk_2")

  @@index([request_id], map: "request_id")
  @@index([user_id], map: "user_id")
}

model contact_requests {
  id               Int                      @id @default(autoincrement())
  name             String                   @db.VarChar(100)
  email            String                   @db.VarChar(100)
  subject          String                   @db.VarChar(255)
  message          String                   @db.Text
  marketing_opt_in Boolean?                 @default(false)
  status           contact_requests_status? @default(New)
  onboarding_token String?                  @unique(map: "onboarding_token") @db.VarChar(64)
  token_expires_at DateTime?                @db.DateTime(0)
  replied_at       DateTime?                @db.Timestamp(0)
  created_at       DateTime                 @default(now()) @db.Timestamp(0)
  contact_replies  contact_replies[]
}

model cost_centers {
  id          Int      @id @default(autoincrement())
  code        String   @unique(map: "code") @db.VarChar(20)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  is_active   Boolean? @default(true)
}

model countries {
  id              Int      @id @default(autoincrement())
  country_name    String   @unique(map: "country_name") @db.VarChar(100)
  country_code    String   @unique(map: "country_code") @db.VarChar(5)
  currency_code   String?  @db.VarChar(10)
  currency_symbol String?  @db.VarChar(10)
  phone_code      String?  @db.VarChar(10)
  is_active       Boolean? @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(0)
}

model customer_addresses {
  id            Int                              @id @default(autoincrement())
  customer_id   Int
  address_type  customer_addresses_address_type? @default(Both)
  address_line1 String?                          @db.VarChar(200)
  address_line2 String?                          @db.VarChar(200)
  city          String?                          @db.VarChar(50)
  state         String?                          @db.VarChar(50)
  country       String?                          @default("India") @db.VarChar(50)
  postal_code   String?                          @db.VarChar(10)
  is_default    Boolean?                         @default(false)
  customers     customers                        @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "customer_addresses_ibfk_1")

  @@index([customer_id], map: "idx_customer")
}

model customer_notes {
  id          Int                       @id @default(autoincrement())
  customer_id Int
  note        String                    @db.Text
  note_type   customer_notes_note_type? @default(General)
  created_by  Int?
  created_at  DateTime                  @default(now()) @db.Timestamp(0)
  customers   customers                 @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "customer_notes_ibfk_1")
  users       users?                    @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "customer_notes_ibfk_2")

  @@index([created_by], map: "created_by")
  @@index([customer_id], map: "idx_customer")
}

model customers {
  id                  Int                         @id @default(autoincrement())
  company_id          Int?
  customer_code       String                      @unique(map: "customer_code") @default(cuid()) @db.VarChar(20)
  company_name        String                      @db.VarChar(200)
  contact_person      String?                     @db.VarChar(100)
  email               String?                     @db.VarChar(100)
  phone               String?                     @db.VarChar(20)
  mobile              String?                     @db.VarChar(20)
  website             String?                     @db.VarChar(100)
  gstin               String?                     @db.VarChar(20)
  pan                 String?                     @db.VarChar(20)
  credit_limit        Decimal?                    @default(0.00) @db.Decimal(12, 2)
  payment_terms       Int?                        @default(0)
  customer_type       customers_customer_type?    @default(Company)
  is_active           Boolean?                    @default(true)
  created_at          DateTime                    @default(now()) @db.Timestamp(0)
  updated_at          DateTime                    @default(now()) @db.Timestamp(0)
  customer_segment    customers_customer_segment? @default(Regular)
  last_purchase_date  DateTime?                   @db.Date
  total_purchases     Decimal?                    @default(0.00) @db.Decimal(15, 2)
  outstanding_balance Decimal?                    @default(0.00) @db.Decimal(12, 2)
  customer_addresses  customer_addresses[]
  customer_notes      customer_notes[]
  invoices            invoices[]
  opportunities       opportunities[]
  payments_received   payments_received[]
  quotations          quotations[]
  sales_orders        sales_orders[]

  @@index([customer_code], map: "idx_code")
  @@index([company_name], map: "idx_company")
  @@index([company_id], map: "idx_customers_company")
}

model departments {
  id                                             Int            @id @default(autoincrement())
  company_id                                     Int?
  name                                           String         @db.VarChar(100)
  parent_id                                      Int?
  manager_id                                     Int?
  description                                    String?        @db.Text
  is_active                                      Boolean?       @default(true)
  created_at                                     DateTime       @default(now()) @db.Timestamp(0)
  departments                                    departments?   @relation("departmentsTodepartments", fields: [parent_id], references: [id], onUpdate: Restrict, map: "departments_ibfk_1")
  other_departments                              departments[]  @relation("departmentsTodepartments")
  employees_departments_manager_idToemployees    employees?     @relation("departments_manager_idToemployees", fields: [manager_id], references: [id], onUpdate: Restrict, map: "departments_ibfk_2")
  designations                                   designations[]
  employees_employees_department_idTodepartments employees[]    @relation("employees_department_idTodepartments")

  @@index([company_id], map: "idx_departments_company")
  @@index([parent_id], map: "idx_parent")
  @@index([manager_id], map: "manager_id")
}

model designations {
  id            Int          @id @default(autoincrement())
  company_id    Int?
  title         String       @db.VarChar(100)
  department_id Int?
  level         Int?         @default(1)
  description   String?      @db.Text
  created_at    DateTime     @default(now()) @db.Timestamp(0)
  departments   departments? @relation(fields: [department_id], references: [id], onUpdate: Restrict, map: "designations_ibfk_1")
  employees     employees[]

  @@index([department_id], map: "department_id")
  @@index([company_id], map: "idx_designations_company")
}

model employee_salary_structure {
  id                 Int                @id @default(autoincrement())
  employee_id        Int
  component_id       Int
  amount             Decimal            @db.Decimal(10, 2)
  effective_from     DateTime           @db.Date
  effective_to       DateTime?          @db.Date
  employees          employees          @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "employee_salary_structure_ibfk_1")
  payroll_components payroll_components @relation(fields: [component_id], references: [id], onUpdate: Restrict, map: "employee_salary_structure_ibfk_2")

  @@index([component_id], map: "component_id")
  @@index([effective_from, effective_to], map: "idx_effective")
  @@index([employee_id], map: "idx_employee")
}

model employees {
  id                                                           Int                         @id @default(autoincrement())
  company_id                                                   Int?
  employee_code                                                String                      @unique(map: "employee_code") @db.VarChar(20)
  user_id                                                      Int?                        @unique(map: "user_id")
  first_name                                                   String                      @db.VarChar(50)
  last_name                                                    String                      @db.VarChar(50)
  email                                                        String                      @unique(map: "email") @db.VarChar(100)
  phone                                                        String?                     @db.VarChar(20)
  date_of_birth                                                DateTime?                   @db.Date
  gender                                                       employees_gender?
  marital_status                                               employees_marital_status?
  blood_group                                                  String?                     @db.VarChar(5)
  address                                                      String?                     @db.Text
  city                                                         String?                     @db.VarChar(50)
  state                                                        String?                     @db.VarChar(50)
  country                                                      String?                     @db.VarChar(50)
  postal_code                                                  String?                     @db.VarChar(10)
  department_id                                                Int?
  designation_id                                               Int?
  reporting_to                                                 Int?
  date_of_joining                                              DateTime                    @db.Date
  date_of_leaving                                              DateTime?                   @db.Date
  employment_type                                              employees_employment_type?  @default(Permanent)
  status                                                       employees_status?           @default(Active)
  bank_name                                                    String?                     @db.VarChar(100)
  bank_account_number                                          String?                     @db.VarChar(50)
  bank_ifsc                                                    String?                     @db.VarChar(20)
  pan_number                                                   String?                     @db.VarChar(20)
  aadhar_number                                                String?                     @db.VarChar(20)
  created_at                                                   DateTime                    @default(now()) @db.Timestamp(0)
  updated_at                                                   DateTime                    @default(now()) @db.Timestamp(0)
  attendance                                                   attendance[]
  departments_departments_manager_idToemployees                departments[]               @relation("departments_manager_idToemployees")
  employee_salary_structure                                    employee_salary_structure[]
  users                                                        users?                      @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "employees_ibfk_1")
  departments_employees_department_idTodepartments             departments?                @relation("employees_department_idTodepartments", fields: [department_id], references: [id], onUpdate: Restrict, map: "employees_ibfk_2")
  designations                                                 designations?               @relation(fields: [designation_id], references: [id], onUpdate: Restrict, map: "employees_ibfk_3")
  employees                                                    employees?                  @relation("employeesToemployees", fields: [reporting_to], references: [id], onUpdate: Restrict, map: "employees_ibfk_4")
  other_employees                                              employees[]                 @relation("employeesToemployees")
  goods_received_notes                                         goods_received_notes[]
  leave_applications_leave_applications_employee_idToemployees leave_applications[]        @relation("leave_applications_employee_idToemployees")
  leave_applications_leave_applications_approved_byToemployees leave_applications[]        @relation("leave_applications_approved_byToemployees")
  payroll                                                      payroll[]
