  theme_color                 String?                     @default("#3b82f6") @db.VarChar(20)
  address_line1               String?                     @db.VarChar(200)
  address_line2               String?                     @db.VarChar(200)
  city                        String?                     @db.VarChar(100)
  state                       String?                     @db.VarChar(100)
  country                     String?                     @default("India") @db.VarChar(100)
  postal_code                 String?                     @db.VarChar(20)
  phone                       String?                     @db.VarChar(20)
  email                       String?                     @db.VarChar(100)
  website                     String?                     @db.VarChar(100)
  gstin                       String?                     @db.VarChar(20)
  pan                         String?                     @db.VarChar(20)
  bank_name                   String?                     @db.VarChar(100)
  bank_account_number         String?                     @db.VarChar(50)
  bank_ifsc                   String?                     @db.VarChar(20)
  bank_branch                 String?                     @db.VarChar(100)
  bank_account_holder         String?                     @db.VarChar(200)
  logo_path                   String?                     @db.VarChar(255)
  terms_conditions            String?                     @db.Text
  created_at                  DateTime                    @default(now()) @db.Timestamp(0)
  updated_at                  DateTime                    @default(now()) @db.Timestamp(0)
  financial_year_start        Int?                        @default(4)
  currency_code               String?                     @default("INR") @db.VarChar(10)
  currency_symbol             String?                     @default("₹") @db.VarChar(10)
  date_format                 String?                     @default("d-m-Y") @db.VarChar(20)
  timezone                    String?                     @default("Asia/Kolkata") @db.VarChar(50)
  invoice_prefix              String?                     @default("INV") @db.VarChar(20)
  quotation_prefix            String?                     @default("QT") @db.VarChar(20)
  invoice_footer              String?                     @db.Text
  company_registration_number String?                     @db.VarChar(100)
  tax_registration_date       DateTime?                   @db.Date
  linkedin_url                String?                     @db.VarChar(255)
  facebook_url                String?                     @db.VarChar(255)
  twitter_url                 String?                     @db.VarChar(255)
  instagram_url               String?                     @db.VarChar(255)
  smtp_host                   String?                     @db.VarChar(100)
  smtp_port                   Int?                        @default(587)
  smtp_username               String?                     @db.VarChar(100)
  smtp_password               String?                     @db.VarChar(255)
  smtp_encryption             String?                     @default("tls") @db.VarChar(10)
  email_from_name             String?                     @db.VarChar(100)
