  last_backup_date            DateTime?                   @db.DateTime(0)
  print_logo_on_invoice       Boolean?                    @default(true)
  is_gst_registered           Boolean?                    @default(false)
  enable_einvoicing           Boolean?                    @default(false)
  company_feature_overrides   company_feature_overrides[]
